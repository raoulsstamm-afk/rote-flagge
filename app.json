{
  "expo": {
    "name": "Rote Flagge",
    "slug": "rote-flagge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "roteflagge",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.raoulsstamm.roteflagge",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.raoulsstamm.roteflagge",
      "adaptiveIcon": {
        "backgroundColor": "#FFF3EA",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF3EA",
          "image": "./assets/splash.png",
          "imageWidth": 160
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#B8463C"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Rote Flagge hört nur zu, solange du erzählst, damit du nicht tippen musst. Nichts wird verschickt.",
          "speechRecognitionPermission": "Damit dein Erzähltes als Text in deinem Tagebuch landet. Wenn möglich passiert das nur auf deinem Handy."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Damit nur du dein Tagebuch öffnen kannst."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
